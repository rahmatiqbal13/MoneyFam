# Supabase project URL (dari Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (dari Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role key — hanya untuk seed script, JANGAN commit key ini!
# Ambil di: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
